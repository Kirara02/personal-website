---
interface Props {
  name: string;
  title: string;
  subtitles?: string[];
  brief: string;
}

const { name, title, subtitles = [title], brief } = Astro.props;
---

<section class="hero container">
  <div class="hero-content reveal">
    <span class="greeting">Hello, I'm</span>
    <h1>{name}</h1>
    <h2 class="gradient-text"><span id="typewriter" data-title={title} data-subtitles={JSON.stringify(subtitles)}></span><span class="type-cursor">|</span></h2>
    <p>{brief}</p>
    <div class="hero-actions">
      <a href="#projects" class="btn btn-primary">View My Work</a>
      <a href="/cv" class="btn btn-outline" target="_blank">Download CV</a>
      <a href="#contact" class="btn btn-outline">Contact Me</a>
    </div>
  </div>
  <div class="hero-image reveal">
    <div class="blob-wrapper">
      <div class="blob"></div>
      <img src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/assets/images/me.jpg`} alt={name} class="profile-img" />
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 100px;
    gap: 40px;
  }

  .hero-content {
    flex: 1;
  }

  .greeting {
    font-size: 1.1rem;
    font-weight: 500;
    color: var(--accent-primary);
    margin-bottom: 10px;
    display: block;
  }

  h1 {
    font-size: 4.5rem;
    margin-bottom: 10px;
    letter-spacing: -2px;
  }

  .gradient-text {
    font-size: 2rem;
    background: var(--accent-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-bottom: 24px;
  }

  p {
    font-size: 1.1rem;
    color: var(--text-secondary);
    max-width: 540px;
    margin-bottom: 40px;
  }

  .hero-actions {
    display: flex;
    gap: 16px;
  }

  .btn {
    padding: 12px 28px;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.95rem;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .btn-primary {
    background: var(--accent-primary);
    color: white;
  }

  .btn-primary:hover {
    background: var(--accent-secondary);
    transform: translateY(-2px);
    box-shadow: 0 10px 20px rgba(124, 58, 237, 0.2);
  }

  .btn-outline {
    border: 1px solid var(--glass-border);
    color: var(--text-primary);
    background: var(--glass-bg);
  }

  .btn-outline:hover {
    background: var(--glass-border);
    transform: translateY(-2px);
  }

  .hero-image {
    flex: 0.8;
    display: flex;
    justify-content: center;
    position: relative;
  }

  .blob-wrapper {
    position: relative;
    width: 400px;
    height: 400px;
  }

  .blob {
    width: 100%;
    height: 100%;
    background: var(--accent-gradient);
    border-radius: 30% 70% 70% 30% / 30% 30% 70% 70%;
    filter: blur(60px);
    opacity: 0.2;
    animation: blobby 10s infinite alternate;
  }

  .profile-img {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 85%;
    height: 85%;
    object-fit: cover;
    border-radius: 30% 70% 70% 30% / 30% 30% 70% 70%;
    border: 4px solid var(--glass-border);
    animation: blobby 10s infinite alternate-reverse;
  }

  @keyframes blobby {
    0% { border-radius: 30% 70% 70% 30% / 30% 30% 70% 70%; }
    100% { border-radius: 70% 30% 30% 70% / 70% 70% 30% 30%; }
  }

  @media (max-width: 1024px) {
    h1 { font-size: 3.5rem; }
  }

  @media (max-width: 768px) {
    .hero {
      flex-direction: column;
      text-align: center;
      padding-top: 120px;
    }
    
    .hero-content { order: 2; }
    .hero-image { order: 1; margin-bottom: 20px; }
    
    p { margin: 0 auto 40px; }
    
    .hero-actions {
      justify-content: center;
    }
    
    .blob-wrapper {
      width: 280px;
      height: 280px;
    }

    h1 {
      font-size: 2.5rem;
    }

    .gradient-text {
      font-size: 1.5rem;
    }
  }

  .type-cursor {
    display: inline-block;
    color: var(--accent-primary);
    margin-left: 4px;
    animation: blink 0.8s infinite alternate;
  }

  @keyframes blink {
    0% { opacity: 1; }
    100% { opacity: 0; }
  }
</style>

<script>
  const typewriter = document.getElementById('typewriter');
  if (typewriter) {
    const defaultTitle = typewriter.getAttribute('data-title') || 'Software Developer';
    const subtitlesAttr = typewriter.getAttribute('data-subtitles');
    let words = [defaultTitle];
    if (subtitlesAttr) {
      try {
        words = JSON.parse(subtitlesAttr);
      } catch (e) {
        console.error('Failed to parse subtitles', e);
      }
    }
    let wordIndex = 0;
    let charIndex = 0;
    let isDeleting = false;
    let delay = 150;

    function type() {
      const currentWord = words[wordIndex];
      if (isDeleting) {
        typewriter!.textContent = currentWord.substring(0, charIndex - 1);
        charIndex--;
        delay = 60;
      } else {
        typewriter!.textContent = currentWord.substring(0, charIndex + 1);
        charIndex++;
        delay = 120;
      }

      if (!isDeleting && charIndex === currentWord.length) {
        delay = 2000; // Pause at end of word
        isDeleting = true;
      } else if (isDeleting && charIndex === 0) {
        isDeleting = false;
        wordIndex = (wordIndex + 1) % words.length;
        delay = 500; // Pause before typing next word
      }

      setTimeout(type, delay);
    }

    setTimeout(type, 1000);
  }
</script>
