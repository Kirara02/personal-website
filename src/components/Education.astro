---
interface Education {
  degree: string;
  school: string;
  year: string;
  description: string;
}

interface Props {
  education: Education[];
}

const { education } = Astro.props;
---

<section id="education" class="section container">
  <h2 class="section-title reveal">Education</h2>
  <div class="education-grid">
    {education.map(item => (
      <div class="education-card glass-card reveal">
        <div class="education-header">
          <div class="degree-info">
            <h3>{item.degree}</h3>
            <h4 class="school">{item.school}</h4>
          </div>
          <span class="year-tag">{item.year}</span>
        </div>
        <p class="description">{item.description}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .education-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 24px;
    max-width: 1000px;
    margin: 0 auto;
  }

  .education-card {
    padding: 30px;
    display: flex;
    flex-direction: column;
    gap: 15px;
  }

  .education-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 15px;
  }

  h3 {
    font-size: 1.3rem;
    color: var(--text-primary);
    margin-bottom: 5px;
  }

  .school {
    font-size: 1rem;
    color: var(--accent-primary);
    font-weight: 500;
  }

  .year-tag {
    background: var(--bg-tertiary);
    border: 1px solid var(--glass-border);
    padding: 5px 12px;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-secondary);
    white-space: nowrap;
  }

  .description {
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  @media (max-width: 640px) {
    .education-header {
      flex-direction: column;
      gap: 10px;
    }
    
    .year-tag {
      align-self: flex-start;
    }
  }
</style>
