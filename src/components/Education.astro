---
interface Education {
  degree: string;
  school: string;
  year: string;
  description: string;
}

interface Props {
  education: Education[];
}

const { education } = Astro.props;
---

<section id="education" class="section container">
  <h2 class="section-title reveal">Education</h2>
  <div class="education-grid">
    {education.map(item => (
      <div class="education-card glass-card reveal">
        <div class="education-header">
          <div class="degree-info">
            <h3>{item.degree}</h3>
            <h4 class="school">{item.school}</h4>
          </div>
          <span class="year-tag">{item.year}</span>
        </div>
        <p class="description">{item.description}</p>
      </div>
    ))}
  </div>
</section>

<script>
  const eduCards = document.querySelectorAll('.education-card');
  eduCards.forEach(card => {
    const cardEl = card as HTMLElement;
    cardEl.addEventListener('mousemove', (e) => {
      const rect = cardEl.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      cardEl.style.setProperty('--mouse-x', `${x}px`);
      cardEl.style.setProperty('--mouse-y', `${y}px`);
    });
  });
</script>

<style>
  .education-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 24px;
    max-width: 1000px;
    margin: 0 auto;
  }

  .education-card {
    padding: 30px;
    display: flex;
    flex-direction: column;
    gap: 15px;
    position: relative;
    overflow: hidden;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .education-card::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(
      200px circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
      rgba(124, 58, 237, 0.12),
      transparent 70%
    );
    opacity: 0;
    transition: opacity 0.5s ease;
    z-index: 0;
    pointer-events: none;
  }

  .education-card:hover::before {
    opacity: 1;
  }

  .education-card:hover {
    transform: translateY(-5px);
    border-color: rgba(124, 58, 237, 0.3);
    box-shadow: 0 15px 30px rgba(0, 0, 0, 0.3), 0 0 20px rgba(124, 58, 237, 0.1);
  }

  .education-header, .description {
    position: relative;
    z-index: 1;
  }

  .education-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 15px;
  }

  h3 {
    font-size: 1.3rem;
    color: var(--text-primary);
    margin-bottom: 5px;
  }

  .school {
    font-size: 1rem;
    color: var(--accent-primary);
    font-weight: 500;
  }

  .year-tag {
    background: var(--bg-tertiary);
    border: 1px solid var(--glass-border);
    padding: 5px 12px;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-secondary);
    white-space: nowrap;
    transition: all 0.3s ease;
  }

  .education-card:hover .year-tag {
    background: var(--accent-primary);
    color: white;
    border-color: var(--accent-primary);
    box-shadow: 0 0 10px rgba(124, 58, 237, 0.3);
  }

  .description {
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  @media (max-width: 640px) {
    .education-header {
      flex-direction: column;
      gap: 10px;
    }
    
    .year-tag {
      align-self: flex-start;
    }
  }
</style>
