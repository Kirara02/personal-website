---
interface Skill {
  name: string;
  level?: number;
  category: string;
}

interface Props {
  skills: Skill[];
}

const { skills } = Astro.props;

// Group skills by category
const categories = [...new Set(skills.map(s => s.category))];

const categoryInfo: Record<string, { title: string; icon: string }> = {
  mobile: {
    title: 'Mobile Development',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="cat-icon"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>`
  },
  android: {
    title: 'Android Native',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="cat-icon"><path d="M12 2a5 5 0 0 0-5 5v3h10V7a5 5 0 0 0-5-5z"/><rect x="6" y="10" width="12" height="10" rx="2"/><path d="M9 22v-2"/><path d="M15 22v-2"/><path d="M4 11.5a1.5 1.5 0 0 1 3 0V15a1.5 1.5 0 0 1-3 0z"/><path d="M17 11.5a1.5 1.5 0 0 1 3 0V15a1.5 1.5 0 0 1-3 0z"/><path d="M9 4.5l-1-1.5"/><path d="M15 4.5l1-1.5"/></svg>`
  },
  ios: {
    title: 'iOS Native',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="cat-icon"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`
  },
  backend: {
    title: 'Backend Engineering',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="cat-icon"><rect x="2" y="2" width="20" height="8" rx="2" ry="2"/><rect x="2" y="14" width="20" height="8" rx="2" ry="2"/><line x1="6" y1="6" x2="6.01" y2="6"/><line x1="6" y1="18" x2="6.01" y2="18"/></svg>`
  },
  desktop: {
    title: 'Desktop Apps',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="cat-icon"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>`
  },
  iot: {
    title: 'Internet of Things',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="cat-icon"><rect x="16" y="16" width="6" height="6" rx="1"/><rect x="2" y="16" width="6" height="6" rx="1"/><rect x="9" y="2" width="6" height="6" rx="1"/><path d="M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3"/><path d="M12 12V8"/></svg>`
  },
  web: {
    title: 'Web Development',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="cat-icon"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>`
  },
  tools: {
    title: 'Tools & Technologies',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="cat-icon"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>`
  }
};

const getCategoryInfo = (category: string) => {
  const info = categoryInfo[category.toLowerCase()];
  if (info) return info;
  return {
    title: category.charAt(0).toUpperCase() + category.slice(1),
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="cat-icon"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>`
  };
};
---

<section id="skills" class="section container">
  <h2 class="section-title reveal">Technical Skills</h2>
  <div class="skills-grid">
    {categories.map(category => {
      const categorySkills = skills.filter(s => s.category === category);
      const hasLevels = categorySkills.some(s => s.level);
      const info = getCategoryInfo(category);

      return (
        <div class={`skill-category glass-card reveal ${!hasLevels ? 'tools-category' : ''}`}>
          <div class="category-header">
            <div class="icon-container" set:html={info.icon} />
            <h3>{info.title}</h3>
          </div>
          <div class={hasLevels ? "skills-list" : "tools-grid"}>
            {categorySkills.map(skill => (
              hasLevels ? (
                <div class="skill-item">
                  <div class="skill-info">
                    <span>{skill.name}</span>
                    {skill.level && <span class="level">{skill.level}%</span>}
                  </div>
                  <div class="progress-bar">
                    <div class="progress" style={`width: ${skill.level}%`}></div>
                  </div>
                </div>
              ) : (
                <span class="tool-tag">
                  <span class="tag-dot"></span>
                  {skill.name}
                </span>
              )
            ))}
          </div>
        </div>
      );
    })}
  </div>
</section>

<style>
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 28px;
  }

  .skill-category {
    height: 100%;
    display: flex;
    flex-direction: column;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    overflow: hidden;
  }

  .skill-category::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, rgba(124, 58, 237, 0.05), rgba(79, 70, 229, 0.05));
    opacity: 0;
    transition: opacity 0.4s ease;
    z-index: 0;
    pointer-events: none;
  }

  .skill-category:hover {
    transform: translateY(-5px);
    border-color: rgba(124, 58, 237, 0.3);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.3), 0 0 20px rgba(124, 58, 237, 0.1);
  }

  .skill-category:hover::before {
    opacity: 1;
  }

  .category-header, .skills-list, .tools-grid {
    position: relative;
    z-index: 1;
  }

  .tools-category {
    grid-column: span 2;
  }

  .category-header {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 24px;
    border-bottom: 1px solid var(--glass-border);
    padding-bottom: 16px;
  }

  .icon-container {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 10px;
    background: rgba(124, 58, 237, 0.08);
    border: 1px solid rgba(124, 58, 237, 0.2);
    color: var(--accent-primary);
    transition: all 0.3s ease;
    flex-shrink: 0;
  }

  .skill-category:hover .icon-container {
    background: var(--accent-primary);
    color: white;
    border-color: var(--accent-primary);
    box-shadow: 0 0 15px rgba(124, 58, 237, 0.4);
  }

  .icon-container :global(svg) {
    width: 20px !important;
    height: 20px !important;
    display: block;
    stroke-width: 2px;
  }

  .category-header h3 {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
  }

  .skills-list {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .tools-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .tool-tag {
    display: inline-flex;
    align-items: center;
    padding: 8px 16px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--glass-border);
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .tag-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent-gradient);
    margin-right: 8px;
    display: inline-block;
    opacity: 0.7;
    transition: transform 0.3s ease, background 0.3s ease;
  }

  .tool-tag:hover {
    background: rgba(124, 58, 237, 0.1);
    color: var(--text-primary);
    border-color: rgba(124, 58, 237, 0.4);
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(124, 58, 237, 0.15);
  }

  .tool-tag:hover .tag-dot {
    transform: scale(1.3);
    background: #fff;
  }

  .skill-item {
    width: 100%;
  }

  .skill-info {
    display: flex;
    justify-content: space-between;
    margin-bottom: 8px;
    font-size: 0.95rem;
    font-weight: 500;
  }

  .level {
    color: var(--text-muted);
    font-size: 0.85rem;
    font-weight: 600;
  }

  .progress-bar {
    height: 6px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 10px;
    overflow: hidden;
    position: relative;
  }

  .progress {
    height: 100%;
    background: var(--accent-gradient);
    border-radius: 10px;
    transform-origin: left;
    transform: scaleX(0);
    transition: transform 1.5s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 0 8px rgba(124, 58, 237, 0.5);
  }

  .reveal.active .progress {
    transform: scaleX(1);
  }

  @media (max-width: 992px) {
    .tools-category {
      grid-column: span 1;
    }
  }

  @media (max-width: 640px) {
    .skills-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
