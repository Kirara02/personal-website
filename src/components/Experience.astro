---
interface WorkHistory {
  company: string;
  position: string;
  period: string;
  description: string;
  image?: string;
}

interface Props {
  workHistory: WorkHistory[];
}

const { workHistory } = Astro.props;
---

<section id="experience" class="section container">
  <h2 class="section-title reveal">Work Experience</h2>
  <div class="timeline">
    <div class="timeline-progress" id="experience-progress"></div>
    {workHistory.map((item, index) => (
      <div class="timeline-item reveal">
        <div class="timeline-dot"></div>
        <div class="timeline-content glass-card">
          <div class="item-header">
            <div class="company-brand">
              {item.image && <img src={item.image.startsWith('/') ? `${import.meta.env.BASE_URL.replace(/\/$/, '')}${item.image}` : item.image} alt={item.company} class="company-logo" />}
              <div>
                <h3>{item.position}</h3>
                <h4 class="company">{item.company}</h4>
              </div>
            </div>
            <span class="period">{item.period}</span>
          </div>
          <p>{item.description}</p>
        </div>
      </div>
    ))}
  </div>
</section>

<script>
  const timeline = document.querySelector('.timeline');
  const progress = document.getElementById('experience-progress');
  const dots = document.querySelectorAll('.timeline-dot');

  if (timeline && progress) {
    const updateProgress = () => {
      const rect = timeline.getBoundingClientRect();
      const viewportHeight = window.innerHeight;
      
      // Calculate how much of the timeline has been scrolled past the middle of the screen
      const startPoint = viewportHeight * 0.7; // start filling when timeline top crosses 70% height
      const scrolled = startPoint - rect.top;
      const totalHeight = rect.height;
      
      let percentage = (scrolled / totalHeight) * 100;
      percentage = Math.max(0, Math.min(100, percentage));
      
      progress.style.height = `${percentage}%`;

      // Highlight timeline dots as they are reached
      dots.forEach(dot => {
        const dotRect = dot.getBoundingClientRect();
        if (dotRect.top < startPoint) {
          dot.classList.add('active');
        } else {
          dot.classList.remove('active');
        }
      });
    };

    window.addEventListener('scroll', updateProgress);
    window.addEventListener('resize', updateProgress);
    
    // Initial call
    updateProgress();
  }
</script>

<style>
  .timeline {
    max-width: 800px;
    margin: 0 auto;
    position: relative;
    padding-left: 30px;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--glass-border);
    z-index: 0;
  }

  .timeline-progress {
    position: absolute;
    left: 0;
    top: 0;
    width: 2px;
    height: 0%;
    background: var(--accent-gradient);
    box-shadow: 0 0 8px var(--accent-primary);
    z-index: 1;
    transition: height 0.1s ease-out;
  }

  .timeline-item {
    margin-bottom: 40px;
    position: relative;
  }

  .timeline-dot {
    position: absolute;
    left: -34px;
    top: 24px;
    width: 10px;
    height: 10px;
    background: var(--bg-primary);
    border: 2px solid var(--glass-border);
    border-radius: 50%;
    z-index: 2;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .timeline-dot.active {
    background: var(--accent-primary);
    border-color: var(--accent-primary);
    box-shadow: 0 0 10px var(--accent-primary), 0 0 20px var(--accent-primary);
    transform: scale(1.3);
  }

  .timeline-content {
    transition: transform 0.3s ease, border-color 0.3s ease;
  }

  .timeline-content:hover {
    transform: translateX(10px);
    border-color: rgba(124, 58, 237, 0.3);
    box-shadow: 0 10px 25px rgba(124, 58, 237, 0.05);
  }

  .item-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 16px;
    flex-wrap: wrap;
    gap: 10px;
  }

  .company-brand {
    display: flex;
    gap: 15px;
    align-items: center;
  }

  .company-logo {
    width: 48px;
    height: 48px;
    border-radius: 8px;
    background: white;
    padding: 4px;
    object-fit: contain;
  }

  h3 {
    font-size: 1.2rem;
    color: var(--text-primary);
    line-height: 1.2;
  }

  .company {
    font-size: 0.95rem;
    color: var(--text-secondary);
    font-weight: 500;
  }

  p {
    font-size: 0.95rem;
    color: var(--text-muted);
  }

  @media (max-width: 640px) {
    .item-header {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
